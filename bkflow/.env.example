# ==========================================
# CẤU HÌNH BẮT BUỘC (ĐỂ CHẠY LOCAL CƠ BẢN)
# ==========================================

# 1. Database (Supabase PostgreSQL connection string)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. URL ứng dụng
NEXT_PUBLIC_APP_URL="http://localhost:5173"

# 3. Supabase Auth (supabase.com)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ==========================================
# TÍNH NĂNG CHÍNH (KHUYÊN DÙNG ĐỂ ĐỦ TRẢI NGHIỆM)
# ==========================================

# 4. Pusher (Realtime đồng bộ kéo thả - pusher.com)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap1"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# 5. UploadThing (Upload file đính kèm card - uploadthing.com)
UPLOADTHING_TOKEN=""

# 6. Unsplash (Lấy ảnh nền Board - unsplash.com/developers)
# (Nếu để trống sẽ fallback về 9 ảnh mặc định trong code)
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=""

# ==========================================
# TÍNH NĂNG NÂNG CAO (CÓ THỂ CẤU HÌNH SAU)
# ==========================================

# 7. OpenAI (Tính năng gợi ý task, AI assistant - platform.openai.com)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# 8. Sentry (Giám sát lỗi - sentry.io, có thể bỏ trống ở local)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# 9. Google Gemini (Trợ lý AI quản lý deadline - aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

