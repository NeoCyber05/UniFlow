# ==========================================
# CẤU HÌNH BẮT BUỘC (ĐỂ CHẠY LOCAL CƠ BẢN)
# ==========================================

# 1. Database (Supabase PostgreSQL connection string)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Direct (session, port 5432) cho prisma db push / migrate
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# 2. URL ứng dụng
NEXT_PUBLIC_APP_URL="http://localhost:5173"
# Trang store của extension UniFlow Capture (Edge Add-ons); bỏ trống thì ẩn nút cài
NEXT_PUBLIC_CAPTURE_EXTENSION_URL=""

# 3. Supabase Auth (supabase.com)
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ==========================================
# TÍNH NĂNG CHÍNH (KHUYÊN DÙNG ĐỂ ĐỦ TRẢI NGHIỆM)
# ==========================================

# 4. Pusher (Realtime đồng bộ kéo thả - pusher.com)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap1"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# 5. UploadThing (Upload file đính kèm card - uploadthing.com)
UPLOADTHING_TOKEN=""

# 6. Unsplash (Lấy ảnh nền Board - unsplash.com/developers)
# (Nếu để trống sẽ fallback về 9 ảnh mặc định trong code)
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=""

# ==========================================
# TÍNH NĂNG NÂNG CAO (CÓ THỂ CẤU HÌNH SAU)
# ==========================================

# 7. OpenAI (Tính năng gợi ý task, AI assistant - platform.openai.com)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# 8. Sentry (Giám sát lỗi - sentry.io, có thể bỏ trống ở local)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# 9. Google Gemini (Trợ lý AI quản lý deadline - aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"


# 10. Web Push - nhắc hạn khi đóng tab (VAPID). Tạo MỘT cặp khóa ổn định, đặt cùng giá trị cho API và worker.
# SUBJECT là URL liên hệ HTTPS của UniFlow. Worker nền: `npm run worker:reminders` (1 replica, không sleep).
WEB_PUSH_PUBLIC_KEY=""
WEB_PUSH_PRIVATE_KEY=""
WEB_PUSH_SUBJECT=""

# Optional: Telegram reminders. Create a bot with @BotFather, then register the webhook once:
# curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook?url=$NEXT_PUBLIC_APP_URL/api/telegram/webhook&secret_token=$TELEGRAM_WEBHOOK_SECRET"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Random [A-Za-z0-9_-]{16,256}; also signs the account-link tokens.
TELEGRAM_WEBHOOK_SECRET=""
