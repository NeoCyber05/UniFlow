// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Board {
  id            String @id @default(uuid())
  userId        String
  title         String
  imageId       String
  imageThumbUrl String @db.Text
  imageFullUrl  String @db.Text
  imageUserName String @db.Text
  imageLinkHTML String @db.Text

  semesterId String?   @unique
  semester   Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  boardType  BoardType @default(TEAM_PROJECT)

  lists   List[]
  labels  Label[]
  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum BoardType {
  SEMESTER
  TEAM_PROJECT
}

model Semester {
  id        String   @id @default(uuid())
  userId    String
  title     String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  board     Board?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, title])
  @@index([userId])
}

model Course {
  id      String  @id @default(uuid())
  boardId String
  board   Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name    String
  code    String?
  credits Int?
  color   String
  order   Int     @default(0)
  cards   Card[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([boardId, name])
  @@index([boardId])
}

model List {
  id         String    @id @default(uuid())
  title      String
  order      Int
  archivedAt DateTime?

  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  cards Card[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
  @@index([boardId, archivedAt, order])
}

model Card {
  id                   String    @id @default(uuid())
  title                String
  order                Int
  description          String?   @db.Text
  descriptionUpdatedAt DateTime  @default(now())
  startDate            DateTime?
  dueDate              DateTime?
  deadlineOn           DateTime? @db.Date
  scheduledOn          DateTime? @db.Date
  scheduledStartAt     DateTime?
  scheduledEndAt       DateTime?
  isCompleted          Boolean   @default(false)
  /// EVENT: lịch để xem (buổi học TKB), không có checkbox, không tính là việc
  kind                 CardKind  @default(TASK)
  reminder             String?
  reminderSetAt        DateTime?
  reminderGeneration   String?
  archivedAt           DateTime?
  archivedByListId     String?
  courseId             String?
  course               Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)

  listId                String
  list                  List             @relation(fields: [listId], references: [id], onDelete: Cascade)
  comments              CardComment[]
  labels                CardLabel[]
  checklists            Checklist[]
  attachments           CardAttachment[]
  blockingDependencies  CardDependency[] @relation("BlockerRelation")
  blockedByDependencies CardDependency[] @relation("BlockedRelation")
  userStates            CardUserState[]
  reminderDeliveries    ReminderDelivery[]
  aiEdits               AiTaskEdit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listId])
  @@index([listId, archivedAt, order])
  @@index([courseId])
}

enum CardKind {
  TASK
  EVENT
}

// Thiết bị nhận Web Push của một tài khoản; endpoint là duy nhất để nhiều tab không tạo thêm bản ghi.
model WebPushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique @db.Text
  p256dh    String
  auth      String
  bindingId String   @default(uuid())
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries ReminderDelivery[]

  @@index([userId, active])
}

// Một lần nhắc của một task (theo phiên `generation`) tới một thiết bị. status: pending|sending|accepted|retry|unknown|failed|cancelled.
model ReminderDelivery {
  id              String    @id @default(uuid())
  cardId          String
  card            Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  recipientUserId String
  subscriptionId  String
  subscription    WebPushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  generation      String
  dueAt           DateTime
  nextAttemptAt   DateTime
  expiresAt       DateTime
  status          String    @default("pending")
  attempts        Int       @default(0)
  claimToken      String?
  leaseUntil      DateTime?
  displayTokenHash String?
  acceptedAt      DateTime?
  errorCode       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([cardId, generation, subscriptionId])
  @@index([status, nextAttemptAt])
  @@index([subscriptionId])
}

model CardDependency {
  id String @id @default(uuid())

  blockerCardId String
  blockerCard   Card   @relation("BlockerRelation", fields: [blockerCardId], references: [id], onDelete: Cascade)

  blockedCardId String
  blockedCard   Card   @relation("BlockedRelation", fields: [blockedCardId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([blockerCardId, blockedCardId])
  @@index([blockerCardId])
  @@index([blockedCardId])
}

// Trạng thái riêng từng người trên một thẻ: gắn sao, ghim "Hôm nay".
model CardUserState {
  cardId      String
  card        Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId      String
  isImportant Boolean   @default(false)
  myDayAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([cardId, userId])
  @@index([userId])
}

model CardAttachment {
  id String @id @default(uuid())

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  type     AttachmentType
  order    Int            @default(0)
  name     String
  url      String         @db.Text
  fileKey  String?
  fileSize Int?
  mimeType String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
}

enum AttachmentType {
  LINK
  FILE
}

model CardComment {
  id     String @id @default(uuid())
  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  userId    String
  userName  String @db.Text
  userImage String @db.Text
  content   String @db.Text

  parentId String?
  parent   CardComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  CardComment[] @relation("CommentReplies")

  reactions CardCommentReaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
  @@index([parentId])
  @@index([userId])
}

model CardCommentReaction {
  id        String      @id @default(uuid())
  commentId String
  comment   CardComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  userId String
  emoji  String

  createdAt DateTime @default(now())

  @@unique([commentId, userId, emoji])
  @@index([commentId])
  @@index([userId])
}

enum NOTIFICATION_TYPE {
  CARD_ASSIGNED
  CHECKLIST_ITEM_ASSIGNED
  BOARD_INVITE
  COMMENT_REPLY
  COMMENT_MENTION
  CARD_REMINDER
}

model Notification {
  id              String @id @default(uuid())
  recipientUserId String

  actorUserId String?
  actorName   String? @db.Text
  actorImage  String? @db.Text

  type    NOTIFICATION_TYPE
  title   String
  message String            @db.Text

  boardId       String?
  boardTitle    String?   @db.Text
  cardId        String?
  cardTitle     String?   @db.Text
  listTitle     String?   @db.Text
  commentId     String?
  dueDate       DateTime?
  triggerTime   DateTime?
  reminderLabel String?
  dedupeKey     String?
  pageId        String?

  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([recipientUserId, readAt, createdAt])
  @@index([boardId])
  @@index([cardId])
  @@index([commentId])
  @@index([dedupeKey])
  @@index([type])
}

enum ACTION {
  CREATE
  UPDATE
  DELETE
}

enum AUDIT_EVENT_TYPE {
  CREATE
  UPDATE
  DELETE
  MOVE
  ASSIGN_MEMBER
  COMMENT
  ATTACHMENT
  CHECKLIST
  DUE_DATE
  DEPENDENCY
  LABEL
}

enum ENTITY_TYPE {
  BOARD
  LIST
  CARD
  CHECKLIST
  CHECKLIST_ITEM
}

model AuditLog {
  id          String           @id @default(uuid())
  boardId     String?
  cardId      String?
  action      ACTION
  eventType   AUDIT_EVENT_TYPE @default(UPDATE)
  entityId    String
  entityType  ENTITY_TYPE
  entityTitle String
  userId      String
  userImage   String           @db.Text
  userName    String           @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
  @@index([boardId, createdAt])
  @@index([boardId, eventType, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model Label {
  id      String      @id @default(uuid())
  boardId String
  board   Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title   String
  color   String
  cards   CardLabel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
}

model CardLabel {
  id      String @id @default(uuid())
  cardId  String
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cardId, labelId])
  @@index([cardId])
  @@index([cardId, createdAt])
  @@index([labelId])
}

model Checklist {
  id     String          @id @default(uuid())
  cardId String
  card   Card            @relation(fields: [cardId], references: [id], onDelete: Cascade)
  title  String
  order  Int             @default(0)
  orderVersion Int        @default(0)
  items  ChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
}

model ChecklistItem {
  id          String    @id @default(uuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  title       String
  isCompleted Boolean   @default(false)
  order       Int
  dueDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([checklistId])
  @@index([checklistId, isCompleted])
}

model BoardAiChat {
  id        String   @id @default(uuid())
  boardId   String
  userId    String
  role      String // "user" | "assistant"
  content   String   @db.Text
  parts     Json?
  createdAt DateTime @default(now())

  @@index([boardId, userId])
  @@index([boardId, userId, createdAt])
}

model UserPreference {
  userId     String @id
  accent     String @default("blue")
  background String @default("glow")
  pageStyle  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotePage {
  id         String     @id @default(uuid())
  userId     String
  title      String     @default("Trang mới")
  content    String     @default("") @db.Text
  style      Json?
  parentId   String?
  parent     NotePage?  @relation("NotePageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   NotePage[] @relation("NotePageTree")
  icon       String?
  isFavorite Boolean    @default(false)
  deletedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  aiEdits   AiNoteEdit[]
  deadlines NoteDeadline[]

  @@index([userId, updatedAt])
  @@index([parentId])
}

// Deadline blocks inside note pages, mirrored from NotePage.content on every content write.
model NoteDeadline {
  id        String   @id @default(uuid())
  userId    String
  pageId    String
  page      NotePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  blockId   String
  title     String   @db.Text
  dueAt     DateTime
  reminder  String   @default("none")
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([pageId, blockId])
  @@index([userId, dueAt])
}

// Opt-in conversion of a legacy deadline block into a Card. Kept after restore and when the Card
// is deleted (cardId has no FK), so the mapping and the original block snapshot are never lost.
model NoteDeadlineTaskMap {
  id                 String    @id @default(uuid())
  userId             String
  pageId             String
  blockId            String
  cardId             String
  requestId          String
  beforeBlock        Json
  beforePageRevision DateTime
  afterPageRevision  DateTime
  cardRevision       DateTime
  convertedAt        DateTime  @default(now())
  restoredAt         DateTime?

  @@unique([pageId, blockId])
  @@index([userId, pageId, requestId])
}

model AiNoteEdit {
  id               String    @id @default(uuid())
  userId           String
  notePageId       String
  notePage         NotePage  @relation(fields: [notePageId], references: [id], onDelete: Cascade)
  beforeContent    String    @db.Text
  afterContent     String    @db.Text
  appliedUpdatedAt DateTime
  undoneAt         DateTime?
  createdAt        DateTime  @default(now())
  // Request receipt (null on rows written before receipts): one write per requestId; replay returns this row.
  requestId          String?
  requestFingerprint String?
  beforeUpdatedAt    DateTime?

  @@unique([userId, requestId])
  @@index([userId, notePageId, createdAt])
}

// Receipt + undo snapshot of one AI task edit. before/after hold only the fields of `operation`
// (validated by lib/ai/assistant/task-edits.ts), never an arbitrary patch.
model AiTaskEdit {
  id                 String    @id @default(uuid())
  userId             String
  cardId             String
  card               Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  requestId          String
  requestFingerprint String
  operation          String
  before             Json
  after              Json
  appliedUpdatedAt   DateTime
  undoneAt           DateTime?
  createdAt          DateTime  @default(now())

  @@unique([userId, requestId])
  @@index([userId, cardId, createdAt])
}
