{
  "name": "hustflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web \"npm:dev:server\" \"npm:dev:web\"",
    "build": "npm run gen:actions && npm run build:web && tsc --noEmit",
    "start": "cross-env NODE_ENV=production tsx --import ./server/register-aliases.mjs server/index.ts",
    "lint": "eslint",
    "test": "tsx --test \"lib/**/*.test.ts\" \"server/**/*.test.ts\" \"web/**/*.test.ts\"",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "gen:actions": "tsx scripts/gen-action-registry.ts",
    "dev:server": "tsx watch --env-file=.env --import ./server/register-aliases.mjs server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "start:local": "cross-env NODE_ENV=production tsx --env-file=.env --import ./server/register-aliases.mjs server/index.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/react": "^4.0.130",
    "@clerk/backend": "^3.25.0",
    "@clerk/react": "^6.17.8",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@hono/node-server": "^2.1.5",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^11.8.0",
    "@sentry/react": "^11.8.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.100.10",
    "@uploadthing/react": "^7.3.3",
    "ai": "^7.0.127",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "hono": "^4.13.13",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.12",
    "lodash": "^4.18.1",
    "lucide-react": "^1.7.0",
    "pusher": "^5.3.3",
    "pusher-js": "^8.5.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.1.1",
    "sonner": "^2.0.7",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "unsplash-js": "^7.0.20",
    "uploadthing": "^7.7.4",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7"
  }
}
